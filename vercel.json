{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node script/build-vercel.mjs",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ]
}
