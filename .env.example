# ── Ticker Radar 환경변수 ──
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env
#
# .env 는 git 에 올라가지 않습니다 (.gitignore 처리됨).

# [필수] Supabase(Postgres) 연결 문자열
# Supabase 대시보드 → Project Settings → Database → Connection string 에서 발급.
#  - 로컬 개발 / drizzle db:push: 직결(Direct, 5432) URL 사용
#  - Vercel 서버리스 런타임: 트랜잭션 풀러(Transaction pooler, 6543) URL 사용
#    (풀러 사용 시 storage 는 prepare:false 로 동작하도록 이미 설정됨)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# [필수] Apify API 토큰 — 한 번만 넣으면 됩니다. (수집 워커에서 사용)
# https://console.apify.com/account/integrations 에서 발급
# 서버는 이 값을 가장 먼저 읽고, 없으면 앱 설정 화면(DB)에 저장된 값을 사용합니다.
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [선택] 사용할 Apify actor (기본값: apidojo~tweet-scraper)
# APIFY_ACTOR=apidojo~tweet-scraper

# [선택] 서버 포트 (기본값: 5000)
# PORT=5000
